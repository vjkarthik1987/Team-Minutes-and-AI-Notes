<% layout('layout') %>
<section class="page-hero compact"><div><div class="v3-kicker">Execution</div><h1>Action Items</h1><p>Grouped by thread and meeting, editable in-place.</p></div><div class="v8-head-actions"><form method="POST" action="/user/actions/refresh"><button class="v5-secondary" type="submit">Refresh AI actions</button></form><a class="v5-primary" href="/user/actions/new">+ Action Item</a><span class="pill-soft"><%= actions.length %> visible</span></div></section>
<section class="v21-action-digest"><div><strong><%= digest?.overdue || 0 %></strong><span>Overdue</span></div><div><strong><%= digest?.stale || 0 %></strong><span>Stale / no update</span></div><div><strong><%= digest?.waiting || 0 %></strong><span>Waiting</span></div><div><strong><%= digest?.escalated || 0 %></strong><span>Escalated</span></div><div><strong><%= digest?.recurring || 0 %></strong><span>Recurring</span></div></section>
<div class="filter-row"><a class="chip <%= !selectedStatus ? 'active' : '' %>" href="/user/actions">All</a><% ['Open','In Progress','Waiting','Done','Dropped'].forEach(st => { %><a class="chip <%= selectedStatus === st ? 'active' : '' %>" href="/user/actions?status=<%= encodeURIComponent(st) %>"><%= st %></a><% }) %></div>
<% if (!actions.length) { %><div class="empty-state"><div class="empty-orb">☕</div><h2>No action items yet</h2><p>Use + Action Item or ask the chatbot to assign one.</p></div><% } else { %>
  <% (groupedActions || []).forEach(g => { %>
    <section class="v8-action-section"><div class="v8-action-section-head"><div><small><%= g.threadName %></small><h2><%= g.meetingSubject %></h2><p><span class="js-local-time" data-iso="<%= g.meetingStartDateTime || '' %>"><%= g.meetingStartDateTime || '' %></span></p><% if (g.transcriptDocId) { %><form method="POST" action="/user/actions/refresh-meeting/<%= g.transcriptDocId %>"><button class="v5-secondary mini" type="submit">Refresh this meeting</button></form><% } %></div><strong><%= g.actions.length %></strong></div>
    <div class="v8-table-wrap"><table class="v8-table v10-actions-table"><thead><tr><th>Action</th><th>Owner</th><th>Due</th><th>Priority</th><th>Status</th><th>Signals</th><th>Source</th><th>Edit</th></tr></thead><tbody>
      <% g.actions.forEach(a => { %><tr><td><a href="/user/actions/<%= a._id %>"><strong><%= a.title %></strong></a><% if (a.description) { %><br><small><%= a.description %></small><% } %></td><td><%= a.ownerName || 'Unassigned' %><br><small><%= a.ownerEmail || '' %></small></td><td><% if (a.dueDateISO) { %><span class="js-local-date" data-iso="<%= a.dueDateISO %>"><%= a.dueDate || 'Unclear' %></span><% } else { %><%= a.dueDate || 'Unclear' %><% } %></td><td><%= a.priority || 'Unclear' %></td><td><%= a.status %></td><td><% if(a.escalated){ %><span class='pill danger'>Escalated</span><% } %><% if(a.recurrence && a.recurrence.enabled){ %><span class='pill-soft'>Recurring</span><% } %><% if(a.comments && a.comments.length){ %><span class='pill-soft'><%= a.comments.length %> update(s)</span><% } %></td><td><%= a.source === 'manual' ? 'Manual' : 'AI' %></td><td><button type="button" onclick="document.getElementById('edit-<%= a._id %>').classList.toggle('open')">Edit</button></td></tr>
      <tr id="edit-<%= a._id %>" class="v10-edit-row"><td colspan="8"><form method="post" action="/user/actions/<%= a._id %>/update" class="v10-inline-edit"><label>Owner<select name="ownerEmail"><option value="">Unassigned</option><% assignableUsers.forEach(u=>{ %><option value="<%= u.email %>" <%= String(a.ownerEmail||'')===String(u.email||'')?'selected':'' %>><%= u.name || u.email %> — <%= u.email %></option><% }) %></select></label><label>Due<input type="text" name="dueDate" value="<%= a.dueDate || '' %>" placeholder="today / Friday / 2026-05-29"></label><label>Priority<select name="priority"><% ['Low','Medium','High','Unclear'].forEach(p=>{ %><option value="<%= p %>" <%= a.priority===p?'selected':'' %>><%= p %></option><% }) %></select></label><label>Status<select name="status"><% ['Open','In Progress','Waiting','Done','Dropped'].forEach(st=>{ %><option value="<%= st %>" <%= a.status===st?'selected':'' %>><%= st %></option><% }) %></select></label><button class="v5-primary">Save</button></form><div class="v21-action-tools"><form method="post" action="/user/actions/<%= a._id %>/comment"><input name="comment" placeholder="Add progress update / blocker note"/><button class="v5-secondary mini">Add update</button></form><form method="post" action="/user/actions/<%= a._id %>/escalate"><input name="escalationNote" placeholder="Why escalate?"/><button class="v5-danger mini">Escalate</button></form><form method="post" action="/user/actions/<%= a._id %>/reassign"><select name="ownerEmail"><option value="">Unassigned</option><% assignableUsers.forEach(u=>{ %><option value="<%= u.email %>"><%= u.name || u.email %> — <%= u.email %></option><% }) %></select><button class="v5-secondary mini">Reassign</button></form></div><% if(a.comments && a.comments.length){ %><div class="v21-action-comments"><% a.comments.slice(-3).forEach(c=>{ %><p><strong><%= c.createdByEmail || 'Update' %>:</strong> <%= c.body %></p><% }) %></div><% } %></td></tr><% }) %>
    </tbody></table></div></section>
  <% }) %>
<% } %>

<script>
(function formatActionDates(){
  document.querySelectorAll('.js-local-time').forEach(el=>{ var iso=el.dataset.iso; if(!iso)return; var d=new Date(iso); if(!isNaN(d)) el.textContent=d.toLocaleString(undefined,{weekday:'short',day:'2-digit',month:'short',hour:'numeric',minute:'2-digit',hour12:true}); });
  document.querySelectorAll('.js-local-date').forEach(el=>{ var iso=el.dataset.iso; if(!iso)return; var d=new Date(iso); if(!isNaN(d)) el.textContent=d.toLocaleDateString(undefined,{weekday:'short',day:'2-digit',month:'short',year:'numeric'}); });
})();
</script>
