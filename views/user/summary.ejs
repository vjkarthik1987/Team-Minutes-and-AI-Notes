<% layout('layout') %>

<section class="simple-page simple-reader-page has-ms-footer">
  <%- include('../partials/user_topbar_simple', { activeNav: 'meetings', showBack: true }) %>
  <main class="simple-reader-main">
    <section class="simple-reader-head">
      <p class="simple-eyebrow">AI Summary</p>
      <h1><%= doc.subject || 'Meeting summary' %></h1>
      <p><%= doc.startDateTime ? new Date(doc.startDateTime).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) : '' %><% if (meetingDurationMinutes) { %> · <%= meetingDurationMinutes %> mins · <%= summaryLineCount %> summary lines<% } %></p>
      <div class="simple-reader-actions">
        <a class="meeting-action primary" data-loading-message="Loading the transcript…" href="/user/transcript/saved/<%= doc._id %>">Transcript</a>
        <% if (canRegenerateSummary) { %><a class="meeting-action" data-loading-message="Regenerating the AI summary…" href="/user/transcript/saved/<%= doc._id %>/summary?regenerate=1">Regenerate summary</a><% } %>
        <button class="meeting-action js-edit-summary" type="button">Edit summary</button>
        <button class="meeting-action js-open-add-thread" type="button">Add to thread</button>
        <a class="meeting-action" href="/user/transcript/saved/<%= doc._id %>/summary/download.txt">Download summary</a>
        <button class="meeting-action" type="button" data-open-issue-modal="summaryIssueModal">Report issue</button>
        <a class="meeting-action" href="/user/meetings">Back to meetings</a>
      </div>
    </section>

    <article class="simple-summary-shell">
      <% if (doc.ai && doc.ai.status === 'error') { %>
        <div class="simple-alert"><%= doc.ai.error || 'AI summary failed.' %></div>
      <% } %>

      <% if (doc.ai && doc.ai.summary) { %>
        <div class="summary-status-card">
          <div>
            <span>✨</span>
            <strong>AI summary ready</strong>
          </div>
          <% if (doc.ai.model) { %><small>Model: <%= doc.ai.model %></small><% } %>
        </div>

        <div class="v30-review-card <%= doc.ai && doc.ai.reviewed ? 'reviewed' : '' %>">
          <div>
            <strong><%= doc.ai && doc.ai.reviewed ? 'Reviewed by human' : 'Not reviewed yet' %></strong>
            <small><% if (doc.ai && doc.ai.reviewedAt) { %>Reviewed by <%= doc.ai.reviewedByEmail || 'someone sensible' %> · <%= new Date(doc.ai.reviewedAt).toLocaleString('en-IN') %><% } else { %>AI drafted this. A quick human check makes it safer to share.<% } %></small>
          </div>
          <form method="POST" action="/user/transcript/saved/<%= doc._id %>/summary/review" data-loading-message="Marking summary as reviewed…">
            <input type="hidden" name="status" value="reviewed" />
            <button class="meeting-action primary" type="submit"><%= doc.ai && doc.ai.reviewed ? 'Reviewed ✓' : 'Mark as reviewed' %></button>
          </form>
        </div>
        <% if (issueSubmitted) { %><div class="simple-alert ok">Thanks — issue logged for admin review.</div><% } %>

        <div class="ai-caveat-card summary-caveat">
          <strong>🧠 AI caveat, with a tiny bow</strong>
          <p>This summary was generated by AI. It may miss nuance, confuse speakers, or behave like it had too much coffee. Please review before sharing — your judgement beats the robot.</p>
        </div>

        <form id="summaryEditForm" class="summary-edit-card hidden" method="POST" action="/user/transcript/saved/<%= doc._id %>/summary/edit" data-loading-message="Saving your edited summary…">
          <div class="summary-edit-head">
            <div>
              <strong>Make this human-perfect</strong>
              <p>Fix speaker attribution, add missing actions, or rewrite any section. Saving updates this meeting’s stored AI summary.</p>
            </div>
            <div class="summary-edit-actions">
              <button class="meeting-action primary" type="submit">Save edits</button>
              <button class="meeting-action js-cancel-edit" type="button">Cancel</button>
            </div>
          </div>
          <textarea name="summary" rows="24" spellcheck="true"><%= doc.ai.summary || '' %></textarea>
        </form>

        <section id="summaryReadView" class="summary-section-grid" aria-label="AI summary sections">
          <% (summarySections || []).forEach(function(section){ %>
            <div class="summary-section-card <%= section.isTasks ? 'summary-tasks-card' : '' %>">
              <h2><%= section.title %></h2>
              <% if (section.rows && section.rows.length) { %>
                <div class="summary-row-list">
                  <% section.rows.forEach(function(row){ %>
                    <% if (row.type === 'topic') { %>
                      <div class="summary-topic-row"><%- row.html || row.text %></div>
                    <% } else if (row.type === 'bullet') { %>
                      <div class="summary-bullet-row"><span>•</span><p><%- row.html || row.text %></p></div>
                    <% } else { %>
                      <div class="summary-note-row"><%- row.html || row.text %></div>
                    <% } %>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </section>
      <% } else { %>
        <section class="simple-empty-card">
          <h2>No AI summary yet</h2>
          <p>No AI summary is available yet. Open this page after the transcript has text, or regenerate from the meeting list.</p>
        </section>
      <% } %>
    </article>
  </main>

  <div id="addToThreadModal" class="thread-modal" aria-hidden="true">
    <div class="thread-modal-backdrop js-close-add-thread"></div>
    <section class="thread-modal-card" role="dialog" aria-modal="true" aria-labelledby="addToThreadTitle">
      <button type="button" class="thread-modal-close js-close-add-thread" aria-label="Close">×</button>
      <div class="thread-modal-head">
        <span>🧵</span>
        <div>
          <p class="simple-eyebrow">Add meeting to thread</p>
          <h2 id="addToThreadTitle">Connect this meeting to a workstream</h2>
          <p>Search 3+ letters, select a thread, and optionally pull in similar recurring meetings.</p>
        </div>
      </div>
      <form method="POST" action="/user/transcript/saved/<%= doc._id %>/add-to-thread" class="thread-modal-form" id="addToThreadForm" data-loading-message="Adding this meeting to the thread…">
        <label>
          <span>Find thread</span>
          <div class="thread-collab-box">
            <input id="addThreadSearch" type="search" placeholder="Type 3+ letters to search threads..." autocomplete="off" />
            <div id="addThreadResults" class="thread-collab-results hidden"></div>
            <div id="selectedThreadChip" class="selected-thread-chip hidden"></div>
          </div>
        </label>
        <input type="hidden" name="threadId" id="selectedThreadId" required />
        <label class="thread-check-row">
          <input type="checkbox" name="addRecurring" value="1" />
          <span>Auto-link future recurring meetings with the same / similar title</span>
        </label>
        <div class="thread-modal-actions">
          <button type="button" class="meeting-action js-close-add-thread">Cancel</button>
          <button type="submit" class="thread-create-submit">Add to thread →</button>
        </div>
      </form>
    </section>
  </div>


  <div id="summaryIssueModal" class="thread-modal" aria-hidden="true">
    <div class="thread-modal-backdrop" data-close-issue-modal="summaryIssueModal"></div>
    <section class="thread-modal-card" role="dialog" aria-modal="true" aria-labelledby="summaryIssueTitle">
      <button type="button" class="thread-modal-close" data-close-issue-modal="summaryIssueModal" aria-label="Close">×</button>
      <div class="thread-modal-head"><span>🚩</span><div><p class="simple-eyebrow">Report issue</p><h2 id="summaryIssueTitle">Something wrong here?</h2><p>Tell us if the transcript, meeting, or AI summary looks off.</p></div></div>
      <form method="POST" action="/user/issues" class="thread-modal-form" data-loading-message="Logging the issue…">
        <input type="hidden" name="targetType" value="summary" />
        <input type="hidden" name="targetId" value="<%= doc._id %>" />
        <input type="hidden" name="targetTitle" value="<%= doc.subject || 'Meeting summary' %>" />
        <input type="hidden" name="returnTo" value="/user/transcript/saved/<%= doc._id %>/summary" />
        <label><span>Issue type</span><select name="issueType"><option value="bad_ai_summary">Bad AI summary</option><option value="wrong_transcript">Wrong transcript</option><option value="wrong_meeting">Wrong meeting</option><option value="missing_transcript">Missing transcript</option><option value="other">Other</option></select></label>
        <label><span>What should we know?</span><textarea name="details" rows="5" placeholder="Example: This looks like the previous occurrence's transcript, not this meeting."></textarea></label>
        <div class="thread-modal-actions"><button type="button" class="meeting-action" data-close-issue-modal="summaryIssueModal">Cancel</button><button class="thread-create-submit" type="submit">Log issue →</button></div>
      </form>
    </section>
  </div>

  <footer class="ms-minutes-footer">🐣 tiny meeting magic · (c) Karthik</footer>
</section>

<script>
(function(){
  const editBtn = document.querySelector('.js-edit-summary');
  const form = document.getElementById('summaryEditForm');
  const read = document.getElementById('summaryReadView');
  const cancel = document.querySelector('.js-cancel-edit');
  if(!editBtn || !form || !read) return;
  function setEditing(on){
    form.classList.toggle('hidden', !on);
    read.classList.toggle('hidden', on);
    editBtn.textContent = on ? 'Editing…' : 'Edit summary';
    if(on){ const ta = form.querySelector('textarea'); if(ta) setTimeout(()=>ta.focus(), 50); }
  }
  editBtn.addEventListener('click', () => setEditing(true));
  cancel?.addEventListener('click', () => setEditing(false));
})();

(function(){
  const modal = document.getElementById('addToThreadModal');
  const openBtn = document.querySelector('.js-open-add-thread');
  const closeBtns = document.querySelectorAll('.js-close-add-thread');
  const search = document.getElementById('addThreadSearch');
  const results = document.getElementById('addThreadResults');
  const selectedId = document.getElementById('selectedThreadId');
  const selectedChip = document.getElementById('selectedThreadChip');
  let timer = null;
  function escapeHtml(v){ return String(v || '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }
  function open(){ modal?.classList.add('open'); modal?.setAttribute('aria-hidden','false'); setTimeout(()=>search?.focus(),80); }
  function close(){ modal?.classList.remove('open'); modal?.setAttribute('aria-hidden','true'); }
  openBtn?.addEventListener('click', open);
  closeBtns.forEach(btn => btn.addEventListener('click', close));
  async function doSearch(q){
    if(!results) return;
    if(q.length < 3){ results.classList.add('hidden'); results.innerHTML=''; return; }
    results.classList.remove('hidden'); results.innerHTML='<div class="thread-collab-loading">Searching threads…</div>';
    try{
      const res = await fetch('/user/threads/search?q=' + encodeURIComponent(q));
      const data = await res.json();
      const threads = data.threads || [];
      if(!threads.length){ results.innerHTML='<div class="thread-collab-empty">No matching threads.</div>'; return; }
      results.innerHTML = threads.map(t => '<button type="button" data-id="'+escapeHtml(t.id)+'" data-name="'+escapeHtml(t.name)+'"><strong>'+escapeHtml(t.name)+'</strong><span>'+escapeHtml([t.clientName, t.status, (t.meetingCount||0)+" meetings"].filter(Boolean).join(' · '))+'</span></button>').join('');
      results.querySelectorAll('button').forEach(btn => btn.addEventListener('click', () => {
        selectedId.value = btn.dataset.id;
        selectedChip.classList.remove('hidden');
        selectedChip.innerHTML = '<span>Selected thread</span><strong>'+escapeHtml(btn.dataset.name)+'</strong><button type="button">×</button>';
        selectedChip.querySelector('button')?.addEventListener('click', () => { selectedId.value=''; selectedChip.classList.add('hidden'); selectedChip.innerHTML=''; });
        search.value=''; results.classList.add('hidden'); results.innerHTML='';
      }));
    }catch(e){ results.innerHTML='<div class="thread-collab-empty">Could not search threads.</div>'; }
  }
  search?.addEventListener('input', () => { clearTimeout(timer); timer=setTimeout(()=>doSearch(search.value.trim()), 220); });
})();


(function(){
  function open(id){ const m=document.getElementById(id); m?.classList.add('open'); m?.setAttribute('aria-hidden','false'); }
  function close(id){ const m=document.getElementById(id); m?.classList.remove('open'); m?.setAttribute('aria-hidden','true'); }
  document.querySelectorAll('[data-open-issue-modal]').forEach(btn=>btn.addEventListener('click',()=>open(btn.dataset.openIssueModal)));
  document.querySelectorAll('[data-close-issue-modal]').forEach(btn=>btn.addEventListener('click',()=>close(btn.dataset.closeIssueModal)));
})();
</script>
