<% layout('layout') %>
<section class="v313-login-page">
  <div class="v313-login-orb one"></div>
  <div class="v313-login-orb two"></div>
  <main class="v313-login-card" aria-label="Ms. Minutes user login">
    <div class="v313-login-logo"><span>✎</span></div>
    <p class="simple-eyebrow">Ms. Minutes</p>
    <h1>Meeting memory, minus the mess.</h1>
    <p>Sign in with Microsoft 365 to open your meetings, transcripts, threads, recall, and Assistant Desk.</p>
    <div class="v313-login-illustration" aria-hidden="true">
      <span></span><span></span><span></span><i>✨</i>
    </div>
    <form method="POST" action="/user/login" class="v313-login-form">
      <button type="submit" class="meeting-action primary">Continue with Microsoft 365 →</button>
    </form>
    <a class="v313-login-small" href="/auth/login">Org/Admin login</a>
  </main>
</section>
