    <span class="ms-brand-face">✎</span>
    <strong>Ms. Minutes</strong>
  </a>
  <button class="ms-mobile-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false">☰ Menu</button>
  <nav class="simple-page-nav ms-user-nav" aria-label="Page navigation" data-mobile-menu-panel>
